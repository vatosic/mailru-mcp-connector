# Nonsecret placeholders. Root-owned 0600 after installation.
NODE_BINARY=/usr/bin/node
MAILRU_USER=REPLACE_WITH_YOUR_MAILRU_ADDRESS
MAILRU_FOLDERS_JSON='["INBOX"]'
MAILRU_SEND_ENABLED=false
MAILRU_ENABLE_HTTP=true
MCP_RESOURCE=https://mail.example.test/mcp
MCP_ISSUER=https://identity.example.test
MCP_JWKS_URI=https://identity.example.test/jwks
MCP_OWNER_SUBJECT=REPLACE_WITH_YOUR_OWNER_SUBJECT
MCP_PORT=3000
