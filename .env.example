# Placeholder only. This file is NOT automatically loaded by Node.
# The owner supplies these values locally; never send a password to the maintainer.
MAILRU_USER=REPLACE_WITH_YOUR_MAILRU_ADDRESS
MAILRU_PASSWORD_FILE=/absolute/private/path/mailru-app-password
MAILRU_FOLDERS_JSON='["INBOX"]'
MAILRU_SEND_ENABLED=false
# Only after deliberate opt-in; persistent, owner-only directory (0700).
# MAILRU_SEND_STATE_DIR=/absolute/private/path/send-state
MAILRU_ENABLE_HTTP=false
